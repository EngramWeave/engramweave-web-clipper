{
	"schemaVersion": "0.1.0",
	"name": "EngramWeave Web Source",
	"behavior": "create",
	"noteContentFormat": "{{content}}",
	"properties": [
		{
			"name": "title",
			"value": "{{title}}",
			"type": "text"
		},
		{
			"name": "source",
			"value": "{{url}}",
			"type": "text"
		},
		{
			"name": "published",
			"value": "{{published}}",
			"type": "date"
		},
		{
			"name": "captured_at",
			"value": "{{date}}",
			"type": "date"
		},
		{
			"name": "author",
			"value": "{{author}}",
			"type": "multitext"
		},
		{
			"name": "annotation",
			"value": "",
			"type": "text"
		},
		{
			"name": "type",
			"value": "raw_source",
			"type": "text"
		},
		{
			"name": "source_type",
			"value": "web",
			"type": "text"
		}
	],
	"triggers": [],
	"noteNameFormat": "{{title|safe_name}}",
	"path": "20_Sources/Web/{{date|date:\"YYYY-MM\"}}"
}